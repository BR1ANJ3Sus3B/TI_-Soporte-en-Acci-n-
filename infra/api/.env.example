# Issuer real comprobado localmente; si Keycloak cambia de host/realm, vuelve a
# copiar el issuer del campo `issuer` de su discovery OIDC.
KEYCLOAK_ISSUER=http://localhost:8080/realms/ti-soporte
# Configura en Keycloak un Audience mapper para el access token y coloca aquí
# exactamente la audiencia que incluya. No se conoce aún porque falta el cliente.
KEYCLOAK_AUDIENCE=ti-soporte-api
# API y Keycloak se conectan por la red Docker keycloak_default.
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/ti-soporte/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=ti-soporte-flutter
METRICS_BEARER_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
MONGODB_URI=mongodb://mongo:27017/ti_soporte_en_accion

# Solo enlaza API al loopback por defecto. Para un teléfono en la LAN se requiere
# un enlace accesible y regla de firewall; preferir ADB reverse durante desarrollo.
API_PORT=3000
API_BIND_ADDRESS=127.0.0.1
