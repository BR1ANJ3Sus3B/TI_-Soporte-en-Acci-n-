<#import "template.ftl" as layout>
<@layout.registrationLayout displayMessage=!messagesPerField.existsError('password','password-confirm'); section>
  <#if section = "header"><div class="novatech-brand"><span class="novatech-mark">N</span><span><strong>TI: Soporte en Acción</strong><small>NovaTech Solutions</small></span></div>
  <#elseif section = "form"><h1 class="novatech-title">Restablece tu contraseña</h1><p class="novatech-intro">Elige una contraseña segura para tu cuenta NovaTech.</p><form id="kc-passwd-update-form" class="novatech-form" action="${url.loginAction}" method="post"><div class="form-group"><label for="password-new">Nueva contraseña</label><div class="novatech-password novatech-input"><span>◈</span><input type="password" id="password-new" name="password-new" autocomplete="new-password" autofocus required /><button type="button" data-password-toggle="password-new">Mostrar</button></div></div><div class="form-group"><label for="password-confirm">Confirmar contraseña</label><div class="novatech-password novatech-input"><span>◈</span><input type="password" id="password-confirm" name="password-confirm" autocomplete="new-password" required /><button type="button" data-password-toggle="password-confirm">Mostrar</button></div></div><button class="novatech-submit" type="submit">GUARDAR CONTRASEÑA</button></form>
  </#if>
</@layout.registrationLayout>
