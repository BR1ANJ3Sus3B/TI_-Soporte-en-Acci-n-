VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_DEMO_MODE=true
# Configuración pública OIDC. No agregues contraseñas, secretos ni tokens.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=TI Soporte en Acción
VITE_KEYCLOAK_CLIENT_ID=ti-soporte-pwa
# Habilita estas opciones sólo tras configurarlas en el realm.
VITE_KEYCLOAK_SELF_REGISTRATION=false
VITE_KEYCLOAK_GOOGLE_ENABLED=false
VITE_KEYCLOAK_FACEBOOK_ENABLED=false
VITE_KEYCLOAK_INSTAGRAM_ENABLED=false
