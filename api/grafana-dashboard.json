{
  "uid": "ti-soporte-api",
  "title": "TI: Soporte en Acción - API y datos",
  "tags": ["ti-soporte", "api", "mongodb", "keycloak"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilidad API",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"ti-soporte-api\"}", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "MongoDB disponible",
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "mongodb_up{job=\"ti-soporte-mongodb\"}", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Keycloak metrics disponible",
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"ti-soporte-keycloak\"}", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Solicitudes API por segundo",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (method, route) (rate(ti_soporte_api_http_requests_total{job=\"ti-soporte-api\"}[5m]))", "legendFormat": "{{method}} {{route}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia API p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(ti_soporte_api_http_request_duration_seconds_bucket{job=\"ti-soporte-api\"}[5m])))", "legendFormat": "{{route}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errores API 4xx/5xx",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(ti_soporte_api_http_requests_total{job=\"ti-soporte-api\",status=~\"4..|5..\"}[5m]))", "legendFormat": "HTTP {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Conexiones MongoDB",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "mongodb_ss_connections{job=\"ti-soporte-mongodb\"}", "legendFormat": "{{state}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Reportes y revisiones de intentos",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 21},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (outcome, status) (rate(ti_soporte_api_mission_attempt_reports_total{job=\"ti-soporte-api\"}[5m]))", "legendFormat": "Envío {{outcome}} · {{status}}"},
        {"refId": "B", "expr": "sum by (decision) (rate(ti_soporte_api_mission_attempt_reviews_total{job=\"ti-soporte-api\"}[5m]))", "legendFormat": "Revisión {{decision}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    }
  ]
}
